{
  "name": "llm-comment",
  "version": "0.1.0",
  "description": "Leave inline comments on AI agent output in a local web UI",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeekFiftyFive/llm-comment.git"
  },
  "bin": {
    "llm-comment": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc && tsc -p web",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --testPathIgnorePatterns=/e2e/",
    "test:e2e": "npm run build && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js test/e2e",
    "dev:server": "npm run build && node dist/cli.js open example.md --wait --no-open --port 4100",
    "dev:web": "vite",
    "prepare": "npm run build",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --testPathIgnorePatterns=/e2e/ --watch",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/hast": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=24"
  }
}
